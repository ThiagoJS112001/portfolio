# =============================================================================
# Variáveis de ambiente de exemplo
# =============================================================================
# Copie este arquivo para `.env.local` e preencha os valores reais.
# NUNCA commit o arquivo `.env.local` (já está protegido pelo .gitignore).
#
# No momento este portfólio é totalmente estático e não exige nenhuma variável
# de ambiente. Este arquivo existe apenas como template para futuras
# integrações (ex.: formulário de contato, analytics, CMS, etc.).
# =============================================================================

# -----------------------------------------------------------------------------
# Formulário de contato (exemplo - descomente quando for usar)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=
# CONTACT_FORM_ENDPOINT=
# CONTACT_FORM_API_KEY=

# -----------------------------------------------------------------------------
# Analytics (exemplo - descomente quando for usar)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_HOTJAR_ID=

# -----------------------------------------------------------------------------
# CMS / Banco de dados (exemplo - descomente quando for usar)
# -----------------------------------------------------------------------------
# DATABASE_URL=
# CMS_API_TOKEN=